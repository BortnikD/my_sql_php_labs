{
  "openapi": "3.0.3",
  "info": {
    "title": "Audit API",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost" }
  ],
  "paths": {
    "/employees": {
      "get": {
        "summary": "Получить всех сотрудников",
        "tags": ["Employees"],
        "responses": {
          "200": {
            "description": "Список сотрудников",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Employee" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Создать сотрудника",
        "tags": ["Employees"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmployeeInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Создан",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatedResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/employees/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "summary": "Получить сотрудника по ID",
        "tags": ["Employees"],
        "responses": {
          "200": {
            "description": "Сотрудник",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Employee" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Обновить сотрудника",
        "tags": ["Employees"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmployeeInput" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Updated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Удалить сотрудника (soft-delete)",
        "tags": ["Employees"],
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Получить все категории",
        "tags": ["Categories"],
        "responses": {
          "200": {
            "description": "Список категорий",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } } }
          }
        }
      },
      "post": {
        "summary": "Создать категорию",
        "tags": ["Categories"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryInput" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/categories/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "summary": "Получить категорию по ID",
        "tags": ["Categories"],
        "responses": {
          "200": { "description": "Категория", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Обновить категорию",
        "tags": ["Categories"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryInput" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Updated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Удалить категорию (soft-delete)",
        "tags": ["Categories"],
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/jobs": {
      "get": {
        "summary": "Получить все работы",
        "tags": ["Jobs"],
        "responses": {
          "200": {
            "description": "Список работ",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Job" } } } }
          }
        }
      },
      "post": {
        "summary": "Создать работу",
        "tags": ["Jobs"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobInput" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/jobs/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "summary": "Получить работу по ID",
        "tags": ["Jobs"],
        "responses": {
          "200": { "description": "Работа", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Обновить работу",
        "tags": ["Jobs"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobInput" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Updated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Удалить работу (soft-delete)",
        "tags": ["Jobs"],
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/timesheets": {
      "get": {
        "summary": "Получить записи табеля",
        "tags": ["Timesheets"],
        "parameters": [
          {
            "name": "employee_id",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Фильтр по сотруднику"
          },
          {
            "name": "job_id",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Фильтр по работе"
          }
        ],
        "responses": {
          "200": {
            "description": "Список записей",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Timesheet" } } } }
          }
        }
      },
      "post": {
        "summary": "Создать запись табеля",
        "tags": ["Timesheets"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TimesheetInput" } } }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/charges": {
      "get": {
        "summary": "Ведомость начислений",
        "description": "Возвращает начисления по завершённым работам (is_completed = TRUE)",
        "tags": ["Charges"],
        "responses": {
          "200": {
            "description": "Список начислений",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ChargeItem" }
                }
              }
            }
          }
        }
      }
    },
    "/timesheets/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "summary": "Получить запись табеля по ID",
        "tags": ["Timesheets"],
        "responses": {
          "200": { "description": "Запись табеля", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Timesheet" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Обновить запись табеля",
        "tags": ["Timesheets"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TimesheetInput" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Updated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Удалить запись табеля (soft-delete)",
        "tags": ["Timesheets"],
        "responses": {
          "200": { "$ref": "#/components/responses/Deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      }
    },
    "schemas": {
      "Employee": {
        "type": "object",
        "properties": {
          "id":          { "type": "integer" },
          "category_id": { "type": "integer" },
          "first_name":  { "type": "string" },
          "last_name":   { "type": "string" },
          "middle_name": { "type": "string", "nullable": true },
          "birth_date":  { "type": "string", "format": "date" },
          "is_deleted":  { "type": "boolean" },
          "updated_at":  { "type": "string", "format": "date-time" },
          "deleted_at":  { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "EmployeeInput": {
        "type": "object",
        "required": ["category_id", "first_name", "last_name", "birth_date"],
        "properties": {
          "category_id": { "type": "integer" },
          "first_name":  { "type": "string" },
          "last_name":   { "type": "string" },
          "middle_name": { "type": "string" },
          "birth_date":  { "type": "string", "format": "date" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id":         { "type": "integer" },
          "name":       { "type": "string" },
          "is_deleted": { "type": "boolean" },
          "updated_at": { "type": "string", "format": "date-time" },
          "deleted_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "CategoryInput": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id":         { "type": "integer" },
          "name":       { "type": "string" },
          "is_deleted": { "type": "boolean" },
          "updated_at": { "type": "string", "format": "date-time" },
          "deleted_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "JobInput": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" }
        }
      },
      "Timesheet": {
        "type": "object",
        "properties": {
          "id":          { "type": "integer" },
          "employee_id": { "type": "integer" },
          "job_id":      { "type": "integer" },
          "hours":       { "type": "number" },
          "is_deleted":  { "type": "boolean" },
          "updated_at":  { "type": "string", "format": "date-time" },
          "deleted_at":  { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "TimesheetInput": {
        "type": "object",
        "required": ["employee_id", "job_id", "hours"],
        "properties": {
          "employee_id": { "type": "integer" },
          "job_id":      { "type": "integer" },
          "hours":       { "type": "number" }
        }
      },
      "ChargeItem": {
        "type": "object",
        "properties": {
          "full_name":    { "type": "string", "example": "И.И.Иванов" },
          "name":         { "type": "string", "description": "Название категории" },
          "rate":         { "type": "number", "description": "Ставка категории" },
          "hours":        { "type": "number", "description": "Часы из табеля" },
          "completed_at": { "type": "string", "format": "date-time", "description": "Дата завершения работы" },
          "paid_out":     { "type": "number", "description": "Итого (rate * hours)" }
        }
      },
      "CreatedResponse": {
        "type": "object",
        "properties": { "id": { "type": "integer" } }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    },
    "responses": {
      "Created": {
        "description": "Ресурс создан",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatedResponse" } } }
      },
      "Updated": {
        "description": "Обновлено",
        "content": { "application/json": { "schema": { "type": "object", "properties": { "updated": { "type": "boolean" } } } } }
      },
      "Deleted": {
        "description": "Удалено",
        "content": { "application/json": { "schema": { "type": "object", "properties": { "deleted": { "type": "boolean" } } } } }
      },
      "BadRequest": {
        "description": "Неверный запрос",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "Не найдено",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    }
  }
}
